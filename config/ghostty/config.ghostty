# Appearance
theme = Catppuccin Mocha
font-family = JetBrainsMono Nerd Font Mono
font-size = 14
background-opacity = 1
window-theme = ghostty
gtk-toolbar-style = flat
window-padding-x = 12
window-padding-y = 10

# Interaction
mouse-hide-while-typing = true

# 50 MB of scrollback history
scrollback-limit = 50000000

# Splits: right, below, focus, and balance.
keybind = ctrl+shift+e=new_split:right
keybind = ctrl+shift+o=new_split:down
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+down=goto_split:down
keybind = ctrl+shift+equal=equalize_splits
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+comma=reload_config
